{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-maker/schemas/shot_map_v1.schema.json",
  "title": "shot_map_v1",
  "description": "Phase 4 shot map (owner decision 2026-10-07 s3). PySceneDetect ContentDetector(threshold=27.0, min_scene_len=15 frames, luma_only=false) over EVERY decoded normalized frame; boundaries are frame-accurate and are never snapped to the 2 fps grid. shot_cut boundary evidence comes only from this artifact. start_frame is the first frame of the shot, end_frame is EXCLUSIVE (= next shot's start_frame; last shot ends at frame_count). Body carries identity/provenance that is not circular; artifact_id, checksum, created_at and storage_location live on the Artifact row (impl plan 3.1) exactly as for transcript_v1 -- a checksum inside the bytes it hashes is impossible and created_at would break content addressing. (Flagged for owner confirmation, Phase-4 review.)",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage_version": {
      "const": "shot_map@1"
    },
    "config_version": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_video_id": {
      "type": "string",
      "format": "uuid"
    },
    "stage": {
      "const": "ANALYZING",
      "description": "Phase 4 artifacts are produced inside the ANALYZING stage (v5.0 2.25 as amended 2026-10-04)."
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "minItems": 1
    },
    "input_sha256s": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 1,
      "description": "Checksums of the input artifacts, same order as input_artifact_ids."
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "compute_stage_input_sha256 of the input artifact IDs (stage idempotency identity)."
    },
    "detector_id": {
      "const": "scenedetect.ContentDetector"
    },
    "detector_version": {
      "type": "string"
    },
    "threshold": {
      "const": 27.0
    },
    "min_scene_len_frames": {
      "const": 15
    },
    "luma_only": {
      "const": false
    },
    "normalized_source_fps": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "frame_count": {
      "type": "integer",
      "minimum": 1
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shot_index": {
            "type": "integer",
            "minimum": 0
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "end_frame": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "shot_index",
          "start_ms",
          "end_ms",
          "start_frame",
          "end_frame"
        ],
        "additionalProperties": false
      }
    },
    "missing_reason": {
      "enum": [
        "no_content",
        "no_evidence",
        "no_detection",
        "no_valid_opening",
        "not_run",
        "not_applicable",
        "not_available_in_stage",
        "extraction_failed",
        "invalid_output",
        "unsupported_language",
        "language_uncertain",
        "alignment_unavailable",
        "lead_in_excessive",
        "no_safe_event_end",
        "too_short",
        "too_long",
        "compression_limit",
        "fragment_no_speech",
        "open_ending",
        "bad_start_edge",
        "bad_end_edge",
        "pipeline_incomplete",
        "reframe_signal_missing",
        null
      ],
      "description": "v5.0 2.16.1 global missing-reason vocabulary; null = value present."
    }
  },
  "required": [
    "schema_version",
    "stage_version",
    "config_version",
    "config_sha256",
    "job_id",
    "source_video_id",
    "stage",
    "input_artifact_ids",
    "input_sha256s",
    "input_sha256",
    "detector_id",
    "detector_version",
    "threshold",
    "min_scene_len_frames",
    "luma_only",
    "normalized_source_fps",
    "frame_count",
    "duration_ms",
    "shots",
    "missing_reason"
  ],
  "additionalProperties": false
}
