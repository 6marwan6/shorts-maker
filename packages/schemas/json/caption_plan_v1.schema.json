{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-maker/schemas/caption_plan_v1.schema.json",
  "title": "caption_plan_v1",
  "description": "v5.0 2.24. Sole caption timing/text-segmentation authority.",
  "type": "object",
  "properties": {
    "caption_plan_id": {"type": "string", "format": "uuid"},
    "verified_edit_plan_id": {"type": "string", "format": "uuid"},
    "schema_version": {"const": 1},
    "stage_version": {"const": "caption_plan@1"},
    "config_version": {"type": "string"},
    "config_sha256": {"type": "string"},
    "caption_mode": {"enum": ["burned_in", "sidecar", "none"]},
    "safe_zone": {
      "type": "object",
      "properties": {
        "x_min": {"type": "number"}, "x_max": {"type": "number"},
        "y_min": {"type": "number"}, "y_max": {"type": "number"}
      },
      "required": ["x_min", "x_max", "y_min", "y_max"],
      "additionalProperties": false
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_start_ms": {"type": "integer", "minimum": 0},
          "output_end_ms": {"type": "integer", "minimum": 0},
          "text": {"type": "string"},
          "line_count": {"type": "integer", "minimum": 1, "maximum": 2},
          "safe_zone": {"type": "string"}
        },
        "required": ["output_start_ms", "output_end_ms", "text", "line_count", "safe_zone"],
        "additionalProperties": false
      }
    }
  },
  "required": ["caption_plan_id", "verified_edit_plan_id", "schema_version", "stage_version",
    "config_version", "config_sha256", "caption_mode", "safe_zone", "cues"],
  "additionalProperties": false
}
