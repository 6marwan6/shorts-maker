  "properties": {
    "schema_version": {
      "const": 1
    },
    "stage_version": {
      "const": "visual_features@1"
    },
    "config_version": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_video_id": {
      "type": "string",
      "format": "uuid"
