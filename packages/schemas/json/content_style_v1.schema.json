{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-maker/schemas/content_style_v1.schema.json",
  "title": "content_style_v1",
  "description": "v5.0 2.37.5.1.",
  "type": "object",
  "properties": {
    "content_style_id": {"type": "string", "format": "uuid"},
    "source_region_id": {"type": "string", "format": "uuid"},
    "schema_version": {"const": 1},
    "stage_version": {"const": "content_style@1"},
    "config_version": {"type": "string"},
    "config_sha256": {"type": "string"},
    "language_code": {"type": "string"},
    "prompt_version": {"const": "style_prompt@1"},
    "model_id": {"type": "string"},
    "temperature": {"const": 0},
    "tokenizer_version": {"const": "style_tokenizer@1"},
    "canonical_passage_sha256": {"type": "string"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "truncated": {"type": "boolean"},
    "raw_output": {"type": "object"},
    "valid": {"type": "boolean"},
    "style_status": {"enum": ["ok", "low_confidence", "invalid_output", "rule_event"]},
    "content_style": {"enum": ["story", "tutorial", "explanation", "conversation_qa", "commentary", "event", "other"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "visual_format": {"enum": ["talking_head", "screen_capture", "mixed", "other_visual"]},
    "extended_range_allowed": {"type": "boolean"}
  },
  "required": ["content_style_id", "source_region_id", "schema_version", "stage_version",
    "config_version", "config_sha256", "language_code", "prompt_version", "model_id",
    "temperature", "tokenizer_version", "canonical_passage_sha256", "input_tokens",
    "truncated", "raw_output", "valid", "style_status", "content_style", "confidence",
    "visual_format", "extended_range_allowed"],
  "additionalProperties": false
}
