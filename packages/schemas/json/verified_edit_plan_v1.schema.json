{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shorts-maker/schemas/verified_edit_plan_v1.schema.json",
  "title": "verified_edit_plan_v1",
  "description": "v5.0 2.36.9.8a. The single content/timeline/audio-join authority after verification (impl plan 3.6): every stage downstream of verification (hook analysis, reframe planning, Tier 2, review UI, captions, renderer) reads only this artifact, never the raw edit_plan_v1. Per 3.6 this artifact must NOT store downstream hook_analysis_id/reframe_plan_id/caption_plan_id -- those are Short Candidate/render dependencies recorded elsewhere (short_candidate_v1). reframe is always null here too (2.36.9.8a rule 2: 'a later reframe result is stored in its own artifact that references verified_edit_plan_id').",
  "type": "object",
  "properties": {
    "verified_edit_plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "stage_version": {
      "const": "verified_plan@1"
    },
    "config_version": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string"
    },
    "study_mode": {
      "type": "boolean"
    },
    "evaluation_mode": {
      "type": "boolean"
    },
    "effective_max_compression_ratio": {
      "type": "number"
    },
    "verification_id": {
      "type": "string",
      "format": "uuid"
    },
    "edit_plan_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_region_id": {
      "type": "string",
      "format": "uuid"
    },
    "lineage_id": {
      "type": "string",
      "format": "uuid"
    },
    "plan_origin": {
      "enum": [
        "model",
        "user_edit"
      ]
    },
    "parent_edit_plan_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "replaces_short_candidate_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "export_profile_id": {
      "type": "string"
    },
    "export_profile_sha256": {
      "type": "string"
    },
    "final_status": {
      "enum": [
        "TRANSCRIPT_VERIFIED_PASS",
        "LAYER1_ONLY_PASS"
      ]
    },
    "human_validation_required": {
      "type": "boolean"
    },
    "region_kind": {
      "enum": [
        "speech_led",
        "event_led"
      ]
    },
    "intensity": {
      "enum": [
        "minimal",
        "balanced",
        "aggressive",
        "study_ratio",
        "user_edit"
      ]
    },
    "study_target_ratio": {
      "type": [
        "number",
        "null"
      ]
    },
    "retained_intervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval_with_units"
      }
    },
    "cuts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cut_id": {
            "type": "string"
          },
          "cut_index": {
            "type": "integer",
            "minimum": 0
          },
          "before_unit_id": {
            "type": "string"
          },
          "after_unit_id": {
            "type": "string"
          },
          "removed_unit_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "cut_id",
          "cut_index",
          "before_unit_id",
          "after_unit_id",
          "removed_unit_ids"
        ],
        "additionalProperties": false
      }
    },
    "micro_edits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "const": "pause_shorten"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "type",
          "start_ms",
          "end_ms"
        ],
        "additionalProperties": false
      }
    },
    "audio_joins": {
      "type": "array",
      "description": "v5.0 2.36.9.2, exact audio_join record shape ('Recorded per cut as audio_join').",
      "items": {
        "type": "object",
        "properties": {
          "cut_id": {
            "type": "string"
          },
          "tail_gap_ms": {
            "type": "integer"
          },
          "head_gap_ms": {
            "type": "integer"
          },
          "nonspeech_tail_ms": {
            "type": "integer"
          },
          "nonspeech_head_ms": {
            "type": "integer"
          },
          "normal_crossfade_available": {
            "type": "boolean"
          },
          "extended_crossfade_available": {
            "type": "boolean"
          },
          "speech_overlap_allowed": {
            "const": false
          },
          "loudness_step_db": {
            "type": "number"
          },
          "crossfade_ms": {
            "type": "integer",
            "minimum": 0
          },
          "applied_crossfade_ms": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "cut_id",
          "tail_gap_ms",
          "head_gap_ms",
          "nonspeech_tail_ms",
          "nonspeech_head_ms",
          "normal_crossfade_available",
          "extended_crossfade_available",
          "speech_overlap_allowed",
          "loudness_step_db",
          "crossfade_ms",
          "applied_crossfade_ms"
        ],
        "additionalProperties": false
      }
    },
    "crossfades": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "type": {
            "const": "audio"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "provisional": {
            "const": false
          }
        },
        "required": [
          "at_ms",
          "type",
          "duration_ms",
          "provisional"
        ],
        "additionalProperties": false
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "output_segment_id": {
            "type": "string",
            "format": "uuid"
          },
          "source_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "source_end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "output_start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "output_end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "speed_factor": {
            "const": 1.0
          }
        },
        "required": [
          "output_segment_id",
          "source_start_ms",
          "source_end_ms",
          "output_start_ms",
          "output_end_ms",
          "speed_factor"
        ],
        "additionalProperties": false
      }
    },
    "final_duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "compression_ratio": {
      "type": "number"
    },
    "compression_band": {
      "enum": [
        "standard",
        "strict"
      ]
    },
    "duration_profile": {
      "enum": [
        "primary",
        "extended"
      ]
    },
    "opening_unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "completion_unit_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "short_hook": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number"
        },
        "type": {
          "enum": [
            "question",
            "number",
            "claim",
            "none"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "score",
        "type",
        "text"
      ],
      "additionalProperties": false
    },
    "content_style_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "final_face_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "final_screen_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "final_visual_format": {
      "enum": [
        "talking_head",
        "screen_capture",
        "mixed",
        "other_visual"
      ]
    },
    "event": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "onset_ms": {
          "type": "integer",
          "minimum": 0
        },
        "settle_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "settle_source": {
          "enum": [
            "detected",
            "capped"
          ]
        },
        "capped_end_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "start_is_nearest_safe_before_onset": {
          "type": "boolean"
        }
      },
      "required": [
        "onset_ms",
        "settle_ms",
        "settle_source",
        "capped_end_ms",
        "start_is_nearest_safe_before_onset"
      ],
      "additionalProperties": false
    },
    "reframe": {
      "type": "null",
      "description": "2.36.9.8a rule 2: always null; the reframe result lives in its own reframe_plan_v1 artifact referencing verified_edit_plan_id."
    }
  },
  "required": [
    "verified_edit_plan_id",
    "schema_version",
    "stage_version",
    "config_version",
    "config_sha256",
    "study_mode",
    "evaluation_mode",
    "effective_max_compression_ratio",
    "verification_id",
    "edit_plan_id",
    "source_region_id",
    "lineage_id",
    "plan_origin",
    "parent_edit_plan_id",
    "replaces_short_candidate_id",
    "export_profile_id",
    "export_profile_sha256",
    "final_status",
    "human_validation_required",
    "region_kind",
    "intensity",
    "study_target_ratio",
    "retained_intervals",
    "cuts",
    "micro_edits",
    "audio_joins",
    "crossfades",
    "timeline",
    "final_duration_ms",
    "compression_ratio",
    "compression_band",
    "duration_profile",
    "opening_unit_id",
    "completion_unit_id",
    "short_hook",
    "content_style_id",
    "final_face_ratio",
    "final_screen_ratio",
    "final_visual_format",
    "event",
    "reframe"
  ],
  "additionalProperties": false,
  "$defs": {
    "interval_with_units": {
      "type": "object",
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 0
        },
        "unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "unit_ids"
      ],
      "additionalProperties": false
    }
  }
}
